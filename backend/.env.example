# 변수명만. 실제 값은 .env에 두고 커밋하지 않는다.
# 개발: SQLite / 배포: MySQL (pip install pymysql)
DATABASE_URL=sqlite:///./momeet.db
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/momeet?charset=utf8mb4

# 쉼표로 구분한 프론트 Origin (예: http://localhost:5173)
CORS_ORIGINS=http://localhost:5173

MEETING_TTL_DAYS=30
TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
MAX_AUTH_FAILURES=5
AUTH_LOCK_MINUTES=5
